{
  "manifest_version": 3,
  "name": "SimPlay – Simulated Playback",
  "version": "0.2.0",
  "description": "Pause video and track a virtual position; resume at the elapsed-time position. Site buffering may continue.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Simulated Playback",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.bilibili.com/*"
      ],
      "js": ["src/sim.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
